      <node id="2" label="Guilherme Goergen">
        <viz:color r="51" g="160" b="44" a="1.0" />
        <attvalues>
          <attvalue for="0" value="http://lattes.cnpq.br/0281142461061985" />
          <attvalue for="1" value="14" />
          <attvalue for="2" value="08/10/2026" />
          <attvalue for="3" value="Professor adjunto da Universidade Federal do Pampa, graduado em Matemática Bacharelado, mestre e doutor em Meteorologia pela Universidade Federal de Santa Maria. Tem interesse nas áreas de Matemática Aplicada, Micrometeorologia, Fundamentos de Probabilidade e Modelos Estatísticos. Trabalha com modelagem computacional dos processos físicos da dinâmica da atmosférica e temas relacionados a Equações Diferenciais, Modelos Dinâmicos, Problemas Inversos e Modelos de Interação Superfície-Atmosfera. Foi bolsista do Programa de Educação Tutorial e das agências de fomento CNPQ e CAPES. (Texto informado pelo autor)" />
